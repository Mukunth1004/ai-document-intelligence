{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/.next",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "PYTHONUNBUFFERED": "1"
  },
  "functions": {
    "backend/api/index.py": {
      "runtime": "python3.11"
    }
  },
  "rewrites": [
    {
      "source": "/_/backend/(.*)",
      "destination": "/backend/api/index.py"
    }
  ]
}
