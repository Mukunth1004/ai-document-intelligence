{
  "buildCommand": "cd backend && pip install -r requirements.txt",
  "outputDirectory": "backend",
  "framework": "python-fastapi",
  "env": {
    "PYTHONUNBUFFERED": "1"
  },
  "functions": {
    "backend/app/main.py": {
      "runtime": "python3.11",
      "maxDuration": 30,
      "memory": 512
    }
  },
  "routes": [
    {
      "src": "/api/.*",
      "dest": "backend/app/main.py"
    }
  ]
}
